# Copia a .env y completa. .env está en .gitignore: el repo es público y los
# organizadores piden no compartir las credenciales del dataset.
ANTHROPIC_API_KEY=

# Credenciales read-only del Data Dictionary PDF (pág. 2, "Data Access Credentials")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
DATASET_S3_URI=s3://factored-datathon-2026-s3-157725502942-us-east-2-an/data/

# Dónde viven raw/bronze/silver (~15-20 GB libres)
DATA_DIR=./data
